# Zkopíruj tento soubor jako `.env` a doplň, co potřebuješ.
# Nic z toho není povinné – bez klíčů aplikace běží s daty z Yahoo Finance
# a s lokálním papírovým (simulovaným) účtem.

# ---------------------------------------------------------------------------
# Obecné
# ---------------------------------------------------------------------------
# Zdroj dat: yahoo | alpaca | ccxt | demo (demo = generovaná data, funguje offline)
DT_DATA_PROVIDER=yahoo
# Broker: paper (lokální simulace) | alpaca | ccxt
DT_BROKER=paper
# Seznam sledovaných symbolů (pro scanner a bota)
DT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,SPY,QQQ
# Složka pro databáze (papírový účet, deník). Výchozí: ~/.daytrader
# DT_DATA_DIR=/cesta/ke/slozce

# Pojistka: dokud není true, aplikace odmítne obchodovat se skutečnými penězi.
DT_LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Papírový účet (lokální simulace)
# ---------------------------------------------------------------------------
DT_PAPER_STARTING_CASH=10000
DT_PAPER_COMMISSION_PER_SHARE=0.0
DT_PAPER_COMMISSION_PCT=0.0
DT_PAPER_MIN_COMMISSION=0.0
DT_PAPER_SLIPPAGE_BPS=2

# ---------------------------------------------------------------------------
# Řízení rizik
# ---------------------------------------------------------------------------
DT_RISK_PER_TRADE_PCT=1.0
DT_MAX_POSITION_PCT=25
DT_MAX_DAILY_LOSS_PCT=3
DT_MAX_OPEN_POSITIONS=3
DT_MAX_TRADES_PER_DAY=10
DT_STOP_ATR_MULT=1.5
DT_TAKE_PROFIT_R=2.0
DT_ALLOW_SHORT=false

# ---------------------------------------------------------------------------
# Automatický bot (bot.bat / daytrader bot / stránka Bot v dashboardu)
# ---------------------------------------------------------------------------
# Strategie: vwap_trend | orb | ema_cross | rsi_reversion | bollinger | macd
DT_BOT_STRATEGY=vwap_trend
DT_BOT_INTERVAL=5m
# Symboly pro bota; prázdné = DT_WATCHLIST. Krypto (BTC-USD) se obchoduje i večer a o víkendu.
DT_BOT_SYMBOLS=AAPL,MSFT,NVDA,AMD,TSLA
# Parametry strategie, např. fast=9,slow=21 (prázdné = výchozí)
DT_BOT_PARAMS=

# ---------------------------------------------------------------------------
# Alpaca (americké akcie/ETF + krypto) – https://alpaca.markets
# Papírový účet je zdarma, klíče najdeš v dashboardu Alpaca (Paper Trading).
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# iex = zdarma (jen část objemu trhu), sip = placené předplatné Alpaca
ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# Kryptoburzy přes CCXT (binance, kraken, coinbase, bybit, coinmate, ...)
# ---------------------------------------------------------------------------
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=
# Některé burzy (např. coinbase, okx) vyžadují ještě passphrase:
CCXT_PASSWORD=
# true = testnet burzy (pokud ho burza má), false = ostrý účet
CCXT_SANDBOX=true
CCXT_QUOTE_CURRENCY=USDT

# ---------------------------------------------------------------------------
# AI komentář (volitelné, PLACENÉ podle spotřeby) – https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
DT_AI_MODEL=claude-opus-5-5
# low | medium | high – vyšší = důkladnější a dražší
DT_AI_EFFORT=medium
